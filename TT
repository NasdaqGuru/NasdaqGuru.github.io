    <!-- Analyst Chat Panel -->
    <div class="analyst-panel" id="analystPanel">
        <div class="analyst-header">
            <div>
                <h4>Faculty Affairs Analyst</h4>
                <div class="privacy-note">🔒 Local-only quick answers. Your question stays in this browser.</div>
            </div>
            <button class="analyst-close" onclick="toggleAnalyst()">✕</button>
        </div>
        <div class="analyst-messages" id="analystMessages">
            <div class="analyst-message bot">
                Hello! I'm the BU Faculty Affairs Analyst. Ask me about headcount, hiring pipelines, retention, or any faculty affairs data. All responses are processed locally.
            </div>
        </div>
        <div class="analyst-input-area">
            <input type="text" id="analystInput" placeholder="Ask about faculty data…" onkeypress="if(event.key==='Enter')sendMessage()">
            <button onclick="sendMessage()">➤</button>
        </div>
    </div>

    <script>
        // ===== INITIALIZATION =====
        document.addEventListener('DOMContentLoaded', () => {
            document.getElementById('loadingOverlay').classList.add('active');
            document.getElementById('lastUpdated').textContent = new Date().toLocaleString();

            // Simulate data loading
            setTimeout(() => {
                document.getElementById('loadingOverlay').classList.remove('active');
                populateKPIs();
            }, 1500);
        });

        // ===== KPI DATA =====
        function populateKPIs() {
            animateValue('kpiTotalFaculty', 0, 2847, 1200);
            animateValue('kpiOpenPositions', 0, 134, 1000);
            animateValue('kpiRetention', 0, 94.2, 1000, '%');
            animateValue('kpiTimeToFill', 0, 67, 800, ' days');
            animateValue('kpiDiversity', 0, 72.4, 1000, '%');
        }

        function animateValue(id, start, end, duration, suffix = '') {
            const el = document.getElementById(id);
            const range = end - start;
            const startTime = performance.now();
            const isDecimal = String(end).includes('.');

            function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const eased = 1 - Math.pow(1 - progress, 3);
                const current = start + range * eased;
                el.textContent = (isDecimal ? current.toFixed(1) : Math.round(current).toLocaleString()) + suffix;
                if (progress < 1) requestAnimationFrame(update);
            }
            requestAnimationFrame(update);
        }

        // ===== FILTERS =====
        function applyFilters() {
            const campus = document.getElementById('campusFilter').value;
            const school = document.getElementById('schoolFilter').value;
            const dept = document.getElementById('deptFilter').value;
            const fy = document.getElementById('fyFilter').value;

            console.log('Filters applied:', { campus, school, dept, fy });
            // In production, this would trigger an API call or data refresh
            showNotification('Filters applied — refreshing data…');
        }

        // ===== SCENARIOS =====
        function setScenario(el) {
            document.querySelectorAll('.scenario-pill').forEach(p => p.classList.remove('active'));
            el.classList.add('active');
            const scenario = el.dataset.scenario;
            if (scenario === 'reset') {
                document.querySelector('[data-scenario="base"]').classList.add('active');
                el.classList.remove('active');
                showNotification('Scenario reset to Base (2% growth)');
            } else {
                showNotification(`Scenario set: ${el.textContent.trim().split('\n')[0]}`);
            }
        }

        // ===== ANALYST CHAT =====
        function toggleAnalyst() {
            const panel = document.getElementById('analystPanel');
            const fab = document.getElementById('analystFab');
            panel.classList.toggle('open');
            fab.style.display = panel.classList.contains('open') ? 'none' : 'flex';
        }

        function sendMessage() {
            const input = document.getElementById('analystInput');
            const msg = input.value.trim();
            if (!msg) return;

            const messagesEl = document.getElementById('analystMessages');

            // Add user message
            messagesEl.innerHTML += `<div class="analyst-message user">${escapeHtml(msg)}</div>`;
            input.value = '';

            // Simulate response (local-only)
            setTimeout(() => {
                const responses = [
                    `Based on current FY2026 data, total faculty headcount is 2,847 across both campuses.`,
                    `The current retention rate stands at 94.2%, up 0.8 percentage points from last year.`,
                    `There are 134 open faculty positions. 62% are on Charles River Campus, 38% on Medical Campus.`,
                    `Under the Base scenario (2% growth), projected FY2027 headcount is approximately 2,904.`,
                    `Average time-to-fill for faculty searches is 67 days, with STEM positions averaging 74 days.`
                ];
                const response = responses[Math.floor(Math.random() * responses.length)];
                messagesEl.innerHTML += `<div class="analyst-message bot">${response}</div>`;
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }, 800);

            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        // ===== UTILITIES =====
        function exportCSV() {
            showNotification('Preparing CSV export…');
            // In production, trigger actual CSV generation
            setTimeout(() => showNotification('✓ Export complete — check downloads'), 1500);
        }

        function refreshData() {
            document.getElementById('loadingOverlay').classList.add('active');
            setTimeout(() => {
                document.getElementById('loadingOverlay').classList.remove('active');
                document.getElementById('lastUpdated').textContent = new Date().toLocaleString();
                populateKPIs();
                showNotification('Data refreshed successfully');
            }, 2000);
        }

        function showNotification(msg) {
            // Simple toast notification
            const existing = document.querySelector('.toast');
            if (existing) existing.remove();

            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.style.cssText = `
                position: fixed; top: 80px; right: 24px; z-index: 10000;
                background: var(--gray-900); color: white; padding: 12px 20px;
                border-radius: 8px; font-size: 0.8125rem; box-shadow: var(--shadow-lg);
                animation: slideIn 0.3s ease;
            `;
            toast.textContent = msg;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
</body>
